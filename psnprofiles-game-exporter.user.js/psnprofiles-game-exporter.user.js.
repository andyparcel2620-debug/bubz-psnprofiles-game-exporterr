
/* 
 * Bubz PSNProfiles Game Exporter
 * Version: 0.1.0
 *
 * Exports game information visible on PSNProfiles to CSV.
 * Missing playtime is left blank, never guessed.
 */

// ==UserScript==
// @name         Bubz PSNProfiles Game Exporter
// @namespace    https://github.com/andyparcel2620-debug/bubz-psnprofiles-game-exporterr
// @version      0.1.0
// @description  Export visible PSNProfiles game information to CSV
// @match        https://psnprofiles.com/*
// @match        https://www.psnprofiles.com/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
  "use strict";

  const BUTTON_ID = "bubz-psnp-export";
  const GAME_LINK = /\/(game|trophies)\//i;

  function clean(value) {
    return (value || "").replace(/\s+/g, " ").trim();
  }

  function csvCell(value) {
    return '"' + String(value ?? "").replace(/"/g, '""') + '"';
  }

  function getTitle(link) {
    return clean(
      link.getAttribute("title") ||
      link.textContent ||
      link.getAttribute("aria-label")
    );
  }

  function getPlatform(text) {
    const match = text.match(/\b(PS5|PS4|PS3|PS Vita|PSP)\b/i);
    if (!match) return "";
    return match[0].toUpperCase().replace("PS VITA", "PS Vita");
  }

  function getHours(text) {
    const patterns = [
      /(?:play\s*time|time\s*played|hours?\s*played|played)\s*[:\-]?\s*(\d+(?:[.,]\d+)?)\s*(hours?|hrs?|h)\b/i,
      /(\d+(?:[.,]\d+)?)\s*(hours?|hrs?)\s*(?:played|playtime)/i
    ];

    for (const pattern of patterns) {
      const match = text.match(pattern);
      if (match) return match[1].replace(",", ".");
    }

    return "";
  }

  function getCompletion(text) {
    if (/platinum earned|platinum trophy|all trophies/i.test(text)) {
      return "Platinum";
    }

    const percent = text.match(/\b(\d{1,3})\s*%\b/);
    return percent ? percent[1] + "%" : "";
  }

  function getTrophySummary(text) {
    const parts = [];

    for (const type of ["Platinum", "Gold", "Silver", "Bronze"]) {
      const pattern = new RegExp(
        type + "\\s*[:x]?\\s*(\\d+)",
        "i"
      );
      const match = text.match(pattern);

      if (match) parts.push(type + ": " + match[1]);
    }

    return parts.join("; ");
  }

  function findGameRows() {
    const links = Array.from(document.querySelectorAll("a[href]"))
      .filter(link => GAME_LINK.test(link.getAttribute("href") || ""));

    const rows = [];
    const seen = new Set();

    for (const link of links) {
      const title = getTitle(link);
      if (!title || title.length < 2) continue;

      const row = link.closest("tr, li, .game, .game-item, .game-card")
        || link.parentElement;

      if (!row) continue;

      const text = clean(row.innerText);
      const platform = getPlatform(text);
      const key = (title + "|" + platform).toLowerCase();

      if (seen.has(key)) continue;
      seen.add(key);

      rows.push({
        game_title: title,
        platform,
        trophies: getTrophySummary(text),
        completion: getCompletion(text),
        hours_played: getHours(text)
      });
    }

    // Fallback for a single game detail page.
    if (!rows.length && GAME_LINK.test(location.pathname)) {
      const title = clean(
        document.querySelector("h1")?.textContent ||
        document.title.replace(/\s*\|\s*PSNProfiles.*$/i, "")
      );

      if (title) {
        const text = clean(document.body.innerText);

        rows.push({
          game_title: title,
          platform: getPlatform(text),
          trophies: getTrophySummary(text),
          completion: getCompletion(text),
          hours_played: getHours(text)
        });
      }
    }

    return rows;
  }

  function downloadCSV(rows) {
    if (!rows.length) {
      alert(
        "No game rows found. Open a PSNProfiles game list or game page."
      );
      return;
    }

    const columns = [
      "game_title",
      "platform",
      "trophies",
      "completion",
      "hours_played",
      "source_url",
      "exported_at"
    ];

    const exportedAt = new Date().toISOString();
    const lines = [columns.map(csvCell).join(",")];

    for (const row of rows) {
      lines.push([
        row.game_title,
        row.platform,
        row.trophies,
        row.completion,
        row.hours_played,
        location.href,
        exportedAt
      ].map(csvCell).join(","));
    }

    const blob = new Blob(
      ["\uFEFF" + lines.join("\r\n")],
      { type: "text/csv;charset=utf-8;" }
    );

    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");

    anchor.href = url;
    anchor.download =
      "psnprofiles-games-" +
      new Date().toISOString().slice(0, 10) +
      ".csv";

    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();

    setTimeout(() => URL.revokeObjectURL(url), 1500);

    alert(
      "Exported " + rows.length +
      " game row(s). Check the CSV for missing data and duplicates."
    );
  }

  function addButton() {
    if (document.getElementById(BUTTON_ID)) return;

    const button = document.createElement("button");
    button.id = BUTTON_ID;
    button.type = "button";
    button.textContent = "Export PSNProfiles CSV";

    Object.assign(button.style, {
      position: "fixed",
      right: "16px",
      bottom: "18px",
      zIndex: "999999",
      padding: "12px 16px",
      border: "0",
      borderRadius: "9px",
      background: "#1769aa",
      color: "#ffffff",
      fontSize: "14px",
      fontWeight: "700",
      cursor: "pointer",
      boxShadow: "0 2px 10px #0004"
    });

    button.addEventListener("click", function () {
      downloadCSV(findGameRows());
    });

    document.body.appendChild(button);
  }

  addButton();
})();
